<robot name="rover">
  <material name="blue">
    <color rgba="0.08 0.35 0.72 1" />
  </material>
  <material name="black">
    <color rgba="0.12 0.14 0.17 1" />
  </material>
  <material name="green">
    <color rgba="0.1 0.8 0.4 1" />
  </material>
  <link name="chassis_link">
    <inertial>
      <mass value="8" />
      <inertia ixx="0.08" ixy="0" ixz="0" iyy="0.12" iyz="0" izz="0.16" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.55 0.40 0.20" />
      </geometry>
      <material name="blue" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.55 0.40 0.20" />
      </geometry>
    </collision>
  </link>
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>
  <link name="left_wheel">
    <inertial>
      <mass value="0.6" />
      <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.009" iyz="0" izz="0.012" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.12" length="0.06" />
      </geometry>
      <material name="black" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.12" length="0.06" />
      </geometry>
    </collision>
  </link>
  <gazebo reference="left_wheel">
    <material>Gazebo/Black</material>
  </gazebo>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="left_wheel" />
    <origin xyz="0 0.26 -0.08" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.01" friction="0.01" />
  </joint>
  <gazebo reference="left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <link name="right_wheel">
    <inertial>
      <mass value="0.6" />
      <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.009" iyz="0" izz="0.012" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.12" length="0.06" />
      </geometry>
      <material name="black" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.12" length="0.06" />
      </geometry>
    </collision>
  </link>
  <gazebo reference="right_wheel">
    <material>Gazebo/Black</material>
  </gazebo>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="right_wheel" />
    <origin xyz="0 -0.26 -0.08" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.01" friction="0.01" />
  </joint>
  <gazebo reference="right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <link name="front_caster">
    <inertial>
      <mass value="0.1" />
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.0015" iyz="0" izz="0.002" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.04" />
      </geometry>
      <material name="black" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.04" />
      </geometry>
    </collision>
  </link>
  <gazebo reference="front_caster">
    <material>Gazebo/Black</material>
  </gazebo>
  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link" />
    <child link="front_caster" />
    <origin xyz="0.22 0 -0.16" />
  </joint>
  <gazebo reference="front_caster">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>
  <link name="rear_caster">
    <inertial>
      <mass value="0.1" />
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.0015" iyz="0" izz="0.002" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.04" />
      </geometry>
      <material name="black" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.04" />
      </geometry>
    </collision>
  </link>
  <gazebo reference="rear_caster">
    <material>Gazebo/Black</material>
  </gazebo>
  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link" />
    <child link="rear_caster" />
    <origin xyz="-0.22 0 -0.16" />
  </joint>
  <gazebo reference="rear_caster">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>
  <link name="lidar_link">
    <inertial>
      <mass value="0.05" />
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.00075" iyz="0" izz="0.001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.055" length="0.06" />
      </geometry>
      <material name="green" />
    </visual>
  </link>
  <gazebo reference="lidar_link">
    <material>Gazebo/Green</material>
  </gazebo>
  <joint name="lidar_link_joint" type="fixed">
    <parent link="base_link" />
    <child link="lidar_link" />
    <origin xyz="0 0 0.15" />
  </joint>
  <gazebo reference="lidar_link_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <link name="camera_link">
    <inertial>
      <mass value="0.05" />
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.00075" iyz="0" izz="0.001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.04 0.14 0.04" />
      </geometry>
      <material name="green" />
    </visual>
  </link>
  <gazebo reference="camera_link">
    <material>Gazebo/Green</material>
  </gazebo>
  <joint name="camera_link_joint" type="fixed">
    <parent link="base_link" />
    <child link="camera_link" />
    <origin xyz="0.29 0 0.08" />
  </joint>
  <gazebo reference="camera_link_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <link name="gps_link">
    <inertial>
      <mass value="0.05" />
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.00075" iyz="0" izz="0.001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.04 0.04 0.02" />
      </geometry>
      <material name="green" />
    </visual>
  </link>
  <gazebo reference="gps_link">
    <material>Gazebo/Green</material>
  </gazebo>
  <joint name="gps_link_joint" type="fixed">
    <parent link="base_link" />
    <child link="gps_link" />
    <origin xyz="0 0 0.12" />
  </joint>
  <gazebo reference="gps_link_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <link name="camera_optical_link" />
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link" />
    <child link="camera_optical_link" />
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679" />
  </joint>
  <link name="base_link" />
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link" />
    <child link="chassis_link" />
    <origin xyz="0 0 0" />
  </joint>
</robot>
