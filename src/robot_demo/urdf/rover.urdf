<robot name="rover">
  <material name="blue">
    <color rgba="0.08 0.35 0.72 1" />
  </material>
  <material name="black">
    <color rgba="0.12 0.14 0.17 1" />
  </material>
  <material name="green">
    <color rgba="0.1 0.8 0.4 1" />
  </material>
  <link name="base_link">
    <inertial>
      <mass value="8" />
      <inertia ixx="0.08" ixy="0" ixz="0" iyy="0.12" iyz="0" izz="0.16" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.55 0.40 0.20" />
      </geometry>
      <material name="blue" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.55 0.40 0.20" />
      </geometry>
    </collision>
  </link>
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>
  <link name="left_wheel">
    <inertial>
      <mass value="0.6" />
      <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.009" iyz="0" izz="0.012" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.12" length="0.06" />
      </geometry>
      <material name="black" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.12" length="0.06" />
      </geometry>
    </collision>
  </link>
  <gazebo reference="left_wheel">
    <material>Gazebo/Black</material>
  </gazebo>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="left_wheel" />
    <origin xyz="0 0.26 -0.08" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.01" friction="0.01" />
  </joint>
  <gazebo reference="left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <link name="right_wheel">
    <inertial>
      <mass value="0.6" />
      <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.009" iyz="0" izz="0.012" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.12" length="0.06" />
      </geometry>
      <material name="black" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.12" length="0.06" />
      </geometry>
    </collision>
  </link>
  <gazebo reference="right_wheel">
    <material>Gazebo/Black</material>
  </gazebo>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="right_wheel" />
    <origin xyz="0 -0.26 -0.08" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.01" friction="0.01" />
  </joint>
  <gazebo reference="right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <link name="front_caster">
    <inertial>
      <mass value="0.1" />
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.0015" iyz="0" izz="0.002" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.04" />
      </geometry>
      <material name="black" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.04" />
      </geometry>
    </collision>
  </link>
  <gazebo reference="front_caster">
    <material>Gazebo/Black</material>
  </gazebo>
  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link" />
    <child link="front_caster" />
    <origin xyz="0.22 0 -0.16" />
  </joint>
  <gazebo reference="front_caster">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>
  <link name="rear_caster">
    <inertial>
      <mass value="0.1" />
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.0015" iyz="0" izz="0.002" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.04" />
      </geometry>
      <material name="black" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.04" />
      </geometry>
    </collision>
  </link>
  <gazebo reference="rear_caster">
    <material>Gazebo/Black</material>
  </gazebo>
  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link" />
    <child link="rear_caster" />
    <origin xyz="-0.22 0 -0.16" />
  </joint>
  <gazebo reference="rear_caster">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>
  <link name="lidar_link">
    <inertial>
      <mass value="0.05" />
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.00075" iyz="0" izz="0.001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.055" length="0.06" />
      </geometry>
      <material name="green" />
    </visual>
  </link>
  <gazebo reference="lidar_link">
    <material>Gazebo/Green</material>
  </gazebo>
  <joint name="lidar_link_joint" type="fixed">
    <parent link="base_link" />
    <child link="lidar_link" />
    <origin xyz="0 0 0.15" />
  </joint>
  <gazebo reference="lidar_link_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <link name="camera_link">
    <inertial>
      <mass value="0.05" />
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.00075" iyz="0" izz="0.001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.04 0.14 0.04" />
      </geometry>
      <material name="green" />
    </visual>
  </link>
  <gazebo reference="camera_link">
    <material>Gazebo/Green</material>
  </gazebo>
  <joint name="camera_link_joint" type="fixed">
    <parent link="base_link" />
    <child link="camera_link" />
    <origin xyz="0.29 0 0.08" />
  </joint>
  <gazebo reference="camera_link_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <link name="gps_link">
    <inertial>
      <mass value="0.05" />
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.00075" iyz="0" izz="0.001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.04 0.04 0.02" />
      </geometry>
      <material name="green" />
    </visual>
  </link>
  <gazebo reference="gps_link">
    <material>Gazebo/Green</material>
  </gazebo>
  <joint name="gps_link_joint" type="fixed">
    <parent link="base_link" />
    <child link="gps_link" />
    <origin xyz="0 0 0.12" />
  </joint>
  <gazebo reference="gps_link_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <link name="camera_optical_link" />
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link" />
    <child link="camera_optical_link" />
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679" />
  </joint>
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>/scan</topic>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.141592653589793</min_angle>
            <max_angle>3.141592653589793</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>
  <gazebo reference="camera_link">
    <sensor name="astra" type="rgbd_camera">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>/camera</topic>
      <camera>
        <horizontal_fov>1.0472</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
        </image>
        <clip>
          <near>0.15</near>
          <far>6</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
  <gazebo reference="gps_link">
    <sensor name="gps" type="navsat">
      <always_on>true</always_on>
      <update_rate>5</update_rate>
      <topic>/gps/fix</topic>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.52</wheel_separation>
      <wheel_radius>0.12</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_acceleration>0.5</max_linear_acceleration>
      <max_angular_acceleration>1.5</max_angular_acceleration>
    </plugin>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>
  <gazebo reference="base_link">
    <sensor name="base_link_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <contact>
        <collision>base_link_collision</collision>
        <collision>base_link_fixed_joint_lump__front_caster_collision_1</collision>
        <collision>base_link_fixed_joint_lump__rear_caster_collision_2</collision>
        <topic>/contacts/base_link</topic>
      </contact>
    </sensor>
  </gazebo>
  <gazebo reference="left_wheel">
    <sensor name="left_wheel_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <contact>
        <collision>left_wheel_collision</collision>
        <topic>/contacts/left_wheel</topic>
      </contact>
    </sensor>
  </gazebo>
  <gazebo reference="right_wheel">
    <sensor name="right_wheel_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <contact>
        <collision>right_wheel_collision</collision>
        <topic>/contacts/right_wheel</topic>
      </contact>
    </sensor>
  </gazebo>
</robot>